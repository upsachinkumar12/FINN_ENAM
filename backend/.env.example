# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit a real key.

# Anthropic API key (console.anthropic.com -> API keys). Without it FINN still runs:
# prices, alerts and rule-based triage work; AI summaries and research are switched off and labelled so.
ANTHROPIC_API_KEY=

# Model routing. Cheap tier = bulk extraction and summaries; strong tier = multi-quarter reasoning.
MODEL_CHEAP=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
LLM_ENABLED=true

# Comma-separated origins allowed to call the API (add your Vercel URL when deployed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: where SQLite, cached PDFs and the vector index live
# DATA_DIR=./data
